APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# One-click admin suggestion on /superadmin. Defaults to on for APP_ENV=local, off elsewhere.
# ADMIN_QUICK_LOGIN=false
# CAPTCHA image on the staff and superadmin sign-in forms (default true).
# LOGIN_CAPTCHA=true
# Joke terminal pop-ups on wrong passwords and a growing sign-in pause on the fourth (default true).
# LOGIN_PRANK=true
# Unlisted superadmin-only preview of the lockdown screen (404 for everyone else).
# LOCKDOWN_PREVIEW_PATH=x7f-q9z/0x2e-lck_n0/dXJ0
# Approximate place for addresses that trigger the lockdown (ip-api.com), and how long records stay.
# GEOIP_ENABLED=true
# SECURITY_EVENT_DAYS=90

# Portal passwords. Set these in production (e.g. Railway Variables): the seeder creates the
# accounts if missing and, when one of these is set, also resets that group to it on deploy.
# One password per account. STAFF_PASSWORD is only a shared fallback for the staff accounts.
# ADMIN_PASSWORD=
# STAFFMRP_PASSWORD=
# STAFFHR_PASSWORD=
# STAFFACC_PASSWORD=
# STAFF_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB Server Configuration (Supabase PostgreSQL / External DB Server)
DB_CONNECTION=pgsql
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=
DB_SSLMODE=require
# Keep the Postgres connection open between requests (faster when the database is far from the app).
# DB_PERSISTENT=true

# Direct connection (IPv6 required)
# DB_HOST=db.your-project-ref.supabase.co
# DB_PORT=5432
# DB_USERNAME=postgres

# SQLite fallback (default local)
# DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Addresses (comma separated) from which a signed-in superadmin keeps the session for SUPERADMIN_SESSION_DAYS.
SUPERADMIN_TRUSTED_IPS=103.171.164.172
SUPERADMIN_SESSION_DAYS=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google Maps Embed API key for the Contact page map (optional, a keyless embed is used when empty)
GOOGLE_MAPS_API_KEY=

VITE_APP_NAME="${APP_NAME}"
